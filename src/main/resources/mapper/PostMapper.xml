<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.board.mapper.PostMapper">

    <resultMap id="postResultMap" type="com.example.board.dto.Post">
        <id     property="id"        column="id"/>
        <result property="title"     column="title"/>
        <result property="content"   column="content"/>
        <result property="writer"    column="writer"/>
        <result property="viewCount" column="view_count"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insertPost" parameterType="com.example.board.dto.Post"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO post (title, content, writer, view_count, created_at, updated_at)
        VALUES (#{title}, #{content}, #{writer}, 0, NOW(), NOW())
    </insert>

    <select id="selectPostList" resultMap="postResultMap">
        SELECT id, title, writer, view_count, created_at, updated_at
        FROM post
        ORDER BY id DESC
    </select>

    <select id="selectPostById" parameterType="long" resultMap="postResultMap">
        SELECT id, title, content, writer, view_count, created_at, updated_at
        FROM post
        WHERE id = #{id}
    </select>

    <update id="increaseViewCount" parameterType="long">
        UPDATE post
        SET view_count = view_count + 1
        WHERE id = #{id}
    </update>

    <update id="updatePost" parameterType="com.example.board.dto.Post">
        UPDATE post
        SET title      = #{title},
            content    = #{content},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deletePost" parameterType="long">
        DELETE FROM post
        WHERE id = #{id}
    </delete>

    <select id="selectPostCount" resultType="int">
        SELECT COUNT(*)
        FROM post
    </select>

    <select id="selectPostListPaging" parameterType="com.example.board.dto.Page" resultMap="postResultMap">
        SELECT id, title, writer, view_count, created_at, updated_at
        FROM post
        ORDER BY id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

</mapper>
